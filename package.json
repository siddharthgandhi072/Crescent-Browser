{
  "name": "crescent",
  "version": "0.1.0",
  "description": "A calm, fast, Arc-style browser built on Chromium.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.js",
    "dist": "electron-builder --mac --publish never"
  },
  "author": "Crescent",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "htm": "3.1.1",
    "preact": "11.2.0"
  },
  "productName": "Crescent",
  "private": true,
  "build": {
    "appId": "app.crescent.browser",
    "productName": "Crescent",
    "copyright": "Crescent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!test/**"
    ],
    "asar": true,
    "electronLanguages": [
      "en",
      "en-GB",
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "artifactName": "Crescent-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can see your location.",
        "NSBluetoothAlwaysUsageDescription": "Websites you allow can connect to Bluetooth devices.",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSUserActivityTypes": [
          "NSUserActivityTypeBrowsingWeb"
        ]
      }
    },
    "protocols": [
      {
        "name": "Web site",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml",
          "shtml"
        ],
        "name": "HTML document",
        "role": "Viewer"
      },
      {
        "ext": [
          "svg",
          "webp",
          "pdf"
        ],
        "name": "Web content",
        "role": "Viewer"
      }
    ],
    "dmg": {
      "title": "Crescent",
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network"
    }
  }
}
